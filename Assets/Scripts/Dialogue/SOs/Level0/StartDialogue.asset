  m_Script: {fileID: 11500000, guid: 92850cb4c5ab6ca44bab66086660c2ae, type: 3}
  m_Name: StartDialogue
  m_EditorClassIdentifier: 
  paragraphs:
  - Hi, I'm a game!
  - I think you should finish me! ^___^
  - I promise it will be fun.
  - You look like a pro, so you probably know that A and D make you move, and SPACE
    makes you jump :-)
  - Your goal is to reach the finish line as quickly as possible. It is important
    to finish each level quickly!
  - There's also a timer and a life counter in the top left corner, but a pro like
    you won't need them, will you? :-)
  - Now I'll unlock the controls and you can reach the finish line!!!
  - Go ahead! ^______^
  emotions: 0000000001000000000000000100000000000000010000000000000001000000
  force: 1
  randomParagraph: 0
